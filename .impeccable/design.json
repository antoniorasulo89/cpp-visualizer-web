  "narrative": {
    "northStar": "The Selectable Workbench",
    "overview": "This system describes only `app/c++_visualizer/wasm-demo`, including its shared interactive flowchart. It does not govern other applications in this repository. The workbench keeps program editing and observed execution together for guided lessons and individual study. Four user-selectable skins express the same operational interface: Laboratorio, Mappa, Segnali and Classica. The earlier direction images are references, not exact reproduction specifications.\n\nLight, flat panels, compact controls and code-first typography support concentrated work. Settings changes presentation immediately while preserving the editor, input, diagram and compiled trace. No photographic or illustrative picture requirement is shipped; the flowchart is an interactive SVG generated from runtime data.",
    "keyCharacteristics": [
      "Four selectable presentations with one shared engine and data model.",
      "Flat, bordered work surfaces and restrained state color.",
      "Platform sans for operations; monospace for source and values.",
      "Responsive workspace with an internally scrollable flowchart."
    ],
    "rules": [
      {
        "name": "The Shared State Rule",
        "body": "Skin colors change presentation; true/false branches keep their shared success/error semantics across skins.",
        "section": "colors"
      },
      {
        "name": "The Operational Type Rule",
        "body": "Keep interface language in the platform sans and program syntax, observed values and editable expressions in monospace.",
        "section": "typography"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "Preserve the existing tonal surfaces and one-pixel structural borders when extending this demo.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve code, input, diagram and compiled trace when changing presentation.",
      "**Do** use the existing semantic color roles and the selected skin's overrides.",
      "**Do** keep native controls, visible keyboard focus and state announcements.",
      "**Do** keep runtime diagram geometry interactive and scroll it within its canvas."
    ],
    "donts": [
      "**Don't** apply this demo's design system to unrelated applications without a separate decision.",
      "**Don't** treat direction mockups as shipped raster assets or claim exact image reproduction.",
      "**Don't** introduce a display identity font into this intentionally operational platform interface.",
      "**Don't** encode branch truth using only a skin's accent color."
    ]
  }
}
